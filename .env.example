# .env.example — キー名のみ。値は絶対に書き込まない。
# 実体は .env（Git 追跡外）に置き、.env は人間のみが編集する。
#
# Notion / Gmail / Google Drive / Google Calendar / Slack / Semrush /
# Supermetrics / Dropbox / Figma / Canva は Claude Code 側の MCP 接続（OAuth）で
# 使うため、ここにキーは不要。以下はスクリプトから直接 API を叩く場合のみ。

# --- 外部 API ---
SEMRUSH_API_KEY=
SUPERMETRICS_API_KEY=

# --- Google（サービスアカウント JSON を使う場合は「パス」だけを書く）---
GOOGLE_APPLICATION_CREDENTIALS=

# --- ローカルツールのパス（環境ごとに異なる）---
SOFFICE_PATH=
