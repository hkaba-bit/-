# --- 認証情報（絶対に追跡しない）---
.env
.env.*
!.env.example
*.key
*.pem
credentials*.json
token*.json
client_secret*.json
service-account*.json

# --- 納品物：実体はリポジトリに載せない ---
**/outputs/*
!**/outputs/.gitkeep

# --- 依存・ビルド ---
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# --- OS / エディタ ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# --- 一時ファイル（Office のロックファイル含む）---
*.tmp
~$*
